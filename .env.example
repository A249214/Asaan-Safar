# ==============================================================================
# TransitPK • Asaan Saffar (آسان سفر) Environment Configuration
# ==============================================================================
# Note: Never commit real production secrets, private keys, or API tokens to git.
# Copy this file to .env.local or set variables in your cloud deployment runner.

# --- Application Server & WebSocket ---
VITE_APP_ENV=production
VITE_APP_NAME="Asaan Saffar • TransitPK Intercity Express"
VITE_APP_URL=https://transitpk.pk
VITE_API_URL=https://api.transitpk.pk/v1
VITE_WS_URL=wss://telemetry.transitpk.pk/ws/fleet

# --- Security & Session Tokens ---
# JWT Secret for server-side verification (Backend microservice)
JWT_SECRET=replace_with_64_byte_cryptographic_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY_AES256=replace_with_256_bit_hex_key_for_pii_vault

# --- External Payment Gateways (Live vs Simulated) ---
# 1. 1LINK 1BILL Integration (Interbank Funds Transfer)
ONE_BILL_ENABLE_LIVE=false
ONE_BILL_INSTITUTION_ID=TRANSITPK_01
ONE_BILL_API_KEY=mock_1link_1bill_key_for_testing
ONE_BILL_ENDPOINT=https://sandbox.1bill.com.pk/api/v2

# 2. Easypaisa Merchant Integration
EASYPAISA_ENABLE_LIVE=false
EASYPAISA_STORE_ID=mock_ep_store_01
EASYPAISA_HASH_KEY=mock_ep_hash_key_for_testing
EASYPAISA_POST_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf

# 3. JazzCash Merchant Gateway
JAZZCASH_ENABLE_LIVE=false
JAZZCASH_MERCHANT_ID=mock_jc_merchant_01
JAZZCASH_PASSWORD=mock_jc_password_testing
JAZZCASH_INTEGRITY_SALT=mock_jc_salt_testing
JAZZCASH_RETURN_URL=https://transitpk.pk/payment/callback/jazzcash

# --- Identity & NADRA Verification Gateway ---
# Citizen CNIC verification for security compliance
NADRA_VERISYS_ENABLE_LIVE=false
NADRA_CLIENT_ID=mock_nadra_client_testing
NADRA_API_SECRET=mock_nadra_secret_testing
NADRA_VERISYS_ENDPOINT=https://sandbox.nadra.gov.pk/verisys/v1/verify

# --- SMS & WhatsApp Notification Gateways ---
# Dispatching digital ticket PNR and bus platform boarding calls
SMS_GATEWAY_PROVIDER=simulated
SMS_GATEWAY_API_KEY=mock_sms_api_key_testing
SMS_MASKING_HEADER=TransitPK
WHATSAPP_BUSINESS_API_TOKEN=mock_whatsapp_token_testing

# --- Database & Storage Configuration ---
# PostgreSQL Primary Cluster (Production transactional data)
DATABASE_URL=postgresql://transitpk_app:change_me_secure_db_pass@db-cluster.internal:5432/transitpk_production?sslmode=require
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# Redis Distributed Cache (Seat Locks & Rate Limiting)
REDIS_URL=redis://default:change_me_redis_pass@redis-cluster.internal:6379/0
REDIS_SEAT_HOLD_TTL_SECONDS=300

# --- Audit & Compliance Logging ---
AUDIT_LOG_RETENTION_DAYS=730
PII_MASKING_STRICT_MODE=true
ENABLE_CONSOLE_PII_LOGGING=false
